{
	"name": "celema/core",
	"description": "Celema core web framework",
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "Ernst",
			"email": "ernst@celema.dev"
		}
	],
	"minimum-stability": "dev",
	"prefer-stable": true,
	"homepage": "https://celema.dev/core",
	"require": {
		"php": "^8.5",
		"ext-fileinfo": "*",
		"ext-mbstring": "*",
		"celema/container": "^0.6",
		"celema/router": "^0.5",
		"psr/http-factory": "^1.0",
		"psr/http-message": "^1.1 || ^2.0",
		"psr/http-message-implementation": "^1.0",
		"psr/http-server-handler": "^1.0",
		"psr/http-server-middleware": "^1.0",
		"psr/log": "^3.0"
	},
	"require-dev": {
		"carthage-software/mago": "1.50.0",
		"celema/server": "^0.2",
		"ernst/coverlyzer": "^0.3",
		"infection/infection": "0.35.6",
		"nyholm/psr7": "^1.5",
		"nyholm/psr7-server": "^1",
		"phpunit/phpunit": "^13.0",
		"vimeo/psalm": "6.19.0"
	},
	"suggest": {
		"nyholm/psr7": "Default PSR-7/PSR-17 implementation used by App::create()",
		"nyholm/psr7-server": "Required alongside nyholm/psr7 for the default factory"
	},
	"autoload": {
		"psr-4": {
			"Celema\\Core\\": "src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Celema\\Core\\Example\\": "app/src",
			"Celema\\Core\\Tests\\": "tests"
		}
	},
	"scripts": {
		"test": "./vendor/bin/phpunit --testdox --no-coverage --colors=always",
		"types": "./vendor/bin/psalm --no-cache",
		"docs:format": "npx prettier@3.6.2 --write --config ./docs/.prettierrc README.md CHANGELOG.md LICENSE.md docs/",
		"docs:lint": "npx markdownlint-cli2@0.22.1 README.md CHANGELOG.md LICENSE.md docs/",
		"lint": [
			"./vendor/bin/mago fmt --check",
			"./vendor/bin/mago lint"
		],
		"coverage:test": "php -d xdebug.mode=coverage ./vendor/bin/phpunit --testdox --path-coverage --colors=always",
		"coverage:analyze": "./vendor/bin/coverlyzer .coverage/coverage.php",
		"coverage": [
			"composer coverage:test",
			"composer coverage:analyze"
		],
		"ci": [
			"composer lint",
			"composer coverage",
			"composer types"
		],
		"ci:full": [
			"composer ci",
			"composer docs:lint"
		],
		"mutation": [
			"@putenv XDEBUG_MODE=coverage",
			"./vendor/bin/infection --threads=max"
		]
	},
	"config": {
		"allow-plugins": {
			"infection/extension-installer": true
		}
	}
}
